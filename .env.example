ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_SECURITY_TOKEN=
RDS_BINLOG_UID=1000
RDS_BINLOG_GID=1000
RDS_BINLOG_PORT=8769
RDS_BINLOG_ALLOWED_HOSTS=
RDS_BINLOG_CLICKHOUSE_SERVING_ENABLED=0
RDS_BINLOG_CLICKHOUSE_CPUS=1.0
RDS_BINLOG_CLICKHOUSE_PIDS_LIMIT=512
RDS_BINLOG_CLICKHOUSE_OSS_ENABLED=0
RDS_BINLOG_CLICKHOUSE_OSS_SERVING_ENABLED=0
RDS_BINLOG_CLICKHOUSE_OSS_PREFIX=sql-insight-clickhouse/v3/
RDS_BINLOG_CLICKHOUSE_OSS_CACHE_GB=40
# 0 means every OSS part, without a time TTL on the ClickHouse object tables.
RDS_BINLOG_CLICKHOUSE_OSS_HISTORY_DAYS=0
RDS_BINLOG_CLICKHOUSE_OSS_BACKFILL_THREADS=2
RDS_BINLOG_CLICKHOUSE_OSS_BACKFILL_INSERT_THREADS=1
RDS_BINLOG_CLICKHOUSE_OSS_BACKFILL_WORKERS=1
RDS_BINLOG_CLICKHOUSE_OSS_QUERY_TABLE=events_query_oss_all_v3
RDS_BINLOG_CLICKHOUSE_OSS_NAME_QUERY_TABLE=events_query_by_name_oss_all_v3
RDS_BINLOG_CLICKHOUSE_OSS_NAME_MV=events_query_oss_all_v3_to_name_mv
RDS_BINLOG_CLICKHOUSE_OSS_MANIFEST=oss-all-v3-manifest.sqlite3
RDS_BINLOG_CLICKHOUSE_RAW_OSS_ENABLED=0
RDS_BINLOG_CLICKHOUSE_RAW_OSS_SERVING_ENABLED=0
RDS_BINLOG_CLICKHOUSE_RAW_OSS_MANIFEST_TABLE=oss_active_parts_v1
RDS_BINLOG_CLICKHOUSE_RAW_OSS_PACKED_TABLE=events_query_packed_v1
RDS_BINLOG_CLICKHOUSE_RAW_OSS_PREFIX=sql-insight-clickhouse/raw-v1/
RDS_BINLOG_CLICKHOUSE_RAW_OSS_CACHE_GB=20
RDS_BINLOG_CLICKHOUSE_SLOWLOG_SERVING_ENABLED=0
RDS_BINLOG_CLICKHOUSE_SLOWLOG_RECONCILE_SECONDS=30
# Production points this at the existing mode-0600 protected JSON credential.
# The default empty file keeps ordinary/local ClickHouse startup unchanged.
RDS_BINLOG_OSS_CREDENTIAL_FILE=./clickhouse/empty-oss-credentials.json
RDS_BINLOG_CLICKHOUSE_IO_FULL_AVG10_MAX=5
# Safe serving defaults. Export higher values only on the explicit one-off
# `docker compose up` used for an observed historical backfill; a normal
# recreate automatically returns to these values.
RDS_BINLOG_CLICKHOUSE_BACKFILL_IO_FULL_AVG10_MAX=10
RDS_BINLOG_SLOWLOG_SOURCE_IO_FULL_AVG10_MAX=10
RDS_BINLOG_CLICKHOUSE_SLOWLOG_BACKFILL_IO_FULL_AVG10_MAX=10
